# URL Backend API Laravel
# Jika frontend dan backend dihosting pada domain yang sama atau menggunakan reverse proxy Nginx:
# Biarkan kosong atau gunakan /api/v1
# VITE_API_URL=/api/v1

# Jika backend berada pada domain/subdomain terpisah (misal: https://api.domainanda.com/api/v1):
# VITE_API_URL=https://api.domainanda.com/api/v1

