# Prevent PHP script execution in uploads directory
<FilesMatch "\.(php|phtml|phar|php5|php7|php8|pl|py|cgi|sh|bash|asp|aspx)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Disable PHP Engine if mod_php is active
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Prevent directory indexing
Options -Indexes -ExecCGI

